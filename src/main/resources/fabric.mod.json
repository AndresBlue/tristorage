{
  "schemaVersion": 1,
  "id": "tristorage",
  "version": "${version}",
  "name": "TriStorage",
  "description": "Almacenamiento enorme y directo mediante tres bloques contiguos.",
  "authors": ["AndresBlue"],
  "license": "MIT",
  "icon": "assets/tristorage/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.andresblue.tristorage.platform.fabric.TriStorageFabric"],
    "client": ["com.andresblue.tristorage.platform.fabric.TriStorageFabricClient"],
    "emi": ["com.andresblue.tristorage.compat.emi.TriStorageEmiPlugin"],
    "jei_mod_plugin": ["com.andresblue.tristorage.compat.jei.TriStorageJeiPlugin"]
  },
  "mixins": [
    "tristorage.mixins.json",
    "tristorage.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.22",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*"
  }
}
